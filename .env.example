# ============================================================================
# NINIT CRM — variables de entorno (PLANTILLA)
# Copiar a .env para desarrollo local. Los valores de acá son FICTICIOS.
# En producción se cargan en Vercel → Settings → Environment Variables.
# ============================================================================

# ── Frontend (van al bundle: sólo claves públicas) ──────────────────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo.ejemplo
VITE_N8N_SEND_WEBHOOK=https://tu-n8n.app.n8n.cloud/webhook/ninit-crm-send
VITE_N8N_EMAIL_REPLY_WEBHOOK=https://tu-n8n.app.n8n.cloud/webhook/ninit-crm-email-reply
VITE_MESSENGER_SEND_ENDPOINT=/api/messenger-send
VITE_ELEVENLABS_API_KEY=sk_ejemplo00000000000000000000000000000000
VITE_ELEVENLABS_VOICE_ID=ErXwobaYiN019PkySvjV
VITE_VAPID_PUBLIC_KEY=BEjemploClavePublicaVapidDeEjemplo0000000000000000000000000000

# ── Serverless (NUNCA en el frontend) ───────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.servicerole.ejemplo
GROQ_API_KEY=gsk_ejemplo000000000000000000000000000000000000000000

# Push
VAPID_PUBLIC_KEY=BEjemploClavePublicaVapidDeEjemplo0000000000000000000000000000
VAPID_PRIVATE_KEY=ejemploClavePrivadaVapid00000000000000000000
VAPID_SUBJECT=mailto:tucorreo@ejemplo.com
PUSH_WEBHOOK_SECRET=un-secreto-largo-y-random

# Messenger
MESSENGER_VERIFY_TOKEN=un-token-de-verificacion-cualquiera
MESSENGER_PAGE_TOKEN=EAAxxxxxxxxxxxxTOKEN_DE_PAGINA_DE_EJEMPLO

# ── Meta Conversions API (eventos del ciclo comercial) ──────────────────────
# Ver META-CAPI.md. Sin META_CAPI_TOKEN + META_DATASET_ID el CRM funciona
# igual: simplemente no manda eventos.

# Token del dataset (Events Manager → Configuración → Generar token de acceso).
META_CAPI_TOKEN=EAAxxxxxxxxxxxxTOKEN_DE_CONVERSIONS_API_DE_EJEMPLO
# Id del Dataset / Pixel (Events Manager → Orígenes de datos).
META_DATASET_ID=1234567890123456
# Versión de la Graph API contra la que se manda.
META_GRAPH_VERSION=v22.0

# Identificadores de mensajería (action_source = business_messaging).
# Messenger: id de la página de Facebook.
META_PAGE_ID=100000000000000
# WhatsApp: id de la cuenta de WhatsApp Business (hace falta junto al ctwa_clid).
META_WHATSAPP_BUSINESS_ACCOUNT_ID=200000000000000
# Instagram: id de la cuenta profesional (opcional).
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=

# action_source para contactos SIN atribución de mensajería.
# Valores válidos de Meta: email, website, app, phone_call, chat,
# physical_store, system_generated, business_messaging, other.
META_ACTION_SOURCE_FALLBACK=chat

# Código de país por defecto para normalizar teléfonos sin prefijo (US = 1).
META_PHONE_COUNTRY_CODE=1

# Ajustes de red del envío a Meta.
META_CAPI_TIMEOUT_MS=8000
META_CAPI_REINTENTOS=3

# Código de prueba del Events Manager (pestaña "Probar eventos").
# Dejar VACÍO en producción: con esto los eventos no cuentan para optimización.
META_TEST_EVENT_CODE=

# Secreto opcional para llamar /api/meta-evento desde n8n o un trigger
# (en vez de con una sesión de vendedor).
META_WEBHOOK_SECRET=
