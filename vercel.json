{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    { "source": "/business", "destination": "https://ntg-business.vercel.app/", "permanent": false },
    { "source": "/business/", "destination": "https://ntg-business.vercel.app/", "permanent": false },
    { "source": "/business/es/", "destination": "https://ntg-business.vercel.app/es/", "permanent": false },
    { "source": "/business/:ruta*/", "destination": "https://ntg-business.vercel.app/:ruta*/", "permanent": false },
    { "source": "/business/:ruta*", "destination": "https://ntg-business.vercel.app/:ruta*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/push-subscribe", "destination": "/api/push?accion=subscribe" },
    { "source": "/api/push-send", "destination": "/api/push?accion=send" },
    { "source": "/api/meta-evento", "destination": "/api/push?accion=meta" },
    { "source": "/api/lead", "destination": "/api/push?accion=lead" },
    { "source": "/api/business-chat", "destination": "/api/push?accion=chat" },
    { "source": "/((?!api/|cotizacion/|business/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/reporte-diario.js": { "maxDuration": 60 },
    "api/push.js": { "maxDuration": 30 },
    "api/cotizacion-firmar.js": {
      "maxDuration": 60,
      "includeFiles": "public/cotizacion/img/**"
    }
  },
  "crons": [
    { "path": "/api/reporte-diario", "schedule": "0 1 * * *" },
    { "path": "/api/reporte-diario", "schedule": "0 2 * * *" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ]
}
